	"type": "module",
	"license": "Apache-2.0",
	"keywords": ["pi-package", "pi", "pi-coding-agent", "extension", "skills", "specs", "todos"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/franndeli/pi-workflow-kit.git"
	},
	"files": ["todos", "spec-graph", "workflow", "skills", "README.md", "LICENSE"],
	"dependencies": {
		"yaml": "2.9.1"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"pi": {
		"extensions": ["./todos/index.ts", "./spec-graph/index.ts", "./workflow/index.ts"],
